#!/usr/bin/env python3
"""AprilTag 实时测量验证脚本（自动启动 apriltag_node）。

直接运行即可，无需手动 ros2 launch。
Ctrl+C 退出时自动关闭 apriltag_node。

用法:
    python3 test_apriltag                                    # 默认参数
    python3 test_apriltag --tag-id 5 --size 0.21             # 自定义 Tag
    python3 test_apriltag --known-distance 1.0               # 与已知距离对比
    python3 test_apriltag --image-topic /camera/color/image_raw
"""

import argparse
import math
import os
import signal
import statistics
import subprocess
import sys
import time
from collections import deque

import rclpy
from rclpy.node import Node
from rclpy.executors import ExternalShutdownException
from apriltag_msgs.msg import AprilTagDetectionArray
import tf2_ros


# ── 输出格式化 ────────────────────────────────────────────────────────

def _describe_yaw(deg: float) -> str:
    """用中文描述机器人相对 Tag 的朝向偏差。"""
    ad = abs(deg)
    if ad < 5:
        return '正对'
    if ad < 15:
        return '轻微偏左' if deg > 0 else '轻微偏右'
    if ad < 45:
        return '偏左' if deg > 0 else '偏右'
    if ad < 135:
        return '左侧方' if deg > 0 else '右侧方'
    return '后方'

def _describe_lat(lat: float) -> str:
    """用中文描述 Tag 在机器人的左右位置。"""
    ad = abs(lat)
    if ad < 0.03:
        return '居中'
    if ad < 0.10:
        return '偏左' if lat > 0 else '偏右'
    return f'{"左" if lat > 0 else "右"}侧 {ad:.2f}m'


class TestApriltag(Node):
    """AprilTag 实时测量，中文可读输出。"""

    def __init__(self, tag_id=0, tag_family='36h11', tag_size=0.16,
                 camera_frame='camera_color_optical_frame',
                 base_frame='base_link', measure_frame='camera_color_optical_frame',
                 sample_batch=50, known_distance=0.0):
        super().__init__('test_apriltag')

        self.declare_parameter('tag_id', tag_id)
        self.declare_parameter('tag_family', tag_family)
        self.declare_parameter('tag_size', tag_size)
        self.declare_parameter('camera_frame', camera_frame)
        self.declare_parameter('base_frame', base_frame)
        self.declare_parameter('measure_frame', measure_frame)
        self.declare_parameter('sample_batch', sample_batch)
        self.declare_parameter('known_distance', known_distance)

        self._tag_id = self._p('tag_id')
        self._camera_frame = self._p('camera_frame')
        self._base_frame = self._p('base_frame')
        self._measure_frame = self._p('measure_frame')
        self._sample_batch = self._p('sample_batch')
        self._known_distance = self._p('known_distance')
        self._det_topic = '/detections'

        tag_family = self._p('tag_family')
        self._tag_frame = f'tag{tag_family}:{self._tag_id}'
        src = self._measure_frame or self._base_frame

        # TF2
        self._tf_buffer = tf2_ros.Buffer()
        self._tf_listener = tf2_ros.TransformListener(self._tf_buffer, self)

        # 订阅 /detections
        self._det_sub = self.create_subscription(
            AprilTagDetectionArray, self._det_topic, self._on_detections, 10)

        # 统计缓冲
        self._buf_dist = deque(maxlen=self._sample_batch)
        self._buf_lat  = deque(maxlen=self._sample_batch)
        self._buf_yaw  = deque(maxlen=self._sample_batch)
        self._count = 0
        self._tf_fails = 0
        self._last_msg_ns = 0
        self._last_det_ns = 0      # 最近一次目标 Tag 检出时刻: /detections 正常发布
                                   # ≠ Tag 在画面里, 移开 Tag 后 apriltag_node 仍发空数组
        self._stale_warned = False # 丢失警告详细版只打一次, 恢复检出后复位

        # 丢失判定阈值: 发布 ~10fps, 1s ≈ 连续 10 帧无检出才算真丢了
        self._stale_sec = 1.0

        self._summary_timer = self.create_timer(2.0, self._print_realtime)
        self._warn_timer = self.create_timer(4.0, self._warn_if_stale)

        print()
        print('╔══════════════════════════════════════════════════╗')
        print('║       AprilTag 实时测量 — 中文可读模式          ║')
        print('╠══════════════════════════════════════════════════╣')
        print(f'║  Tag:      {self._tag_frame:<30s} ║')
        print(f'║  坐标系:   {src:<30s} ║')
        print(f'║  相机帧:   {self._camera_frame:<30s} ║')
        if self._known_distance > 0:
            print(f'║  已知距离: {self._known_distance:.3f} m{" "*25} ║')
        print('╚══════════════════════════════════════════════════╝')
        print()
        print('  把 Tag 放到相机前即可。按 Ctrl+C 退出。')
        print()

    def _p(self, name):
        return self.get_parameter(name).value

    def _on_detections(self, msg: AprilTagDetectionArray):
        self._last_msg_ns = self.get_clock().now().nanoseconds
        for det in msg.detections:
            if det.id == self._tag_id:
                self._count += 1
                self._last_det_ns = self._last_msg_ns
                self._stale_warned = False
                self._lookup_and_log()
                return

    def _det_age(self) -> float:
        """距最近一次目标 Tag 检出的秒数; 从未检出返回 inf。"""
        if self._last_det_ns == 0:
            return float('inf')
        return (self.get_clock().now().nanoseconds - self._last_det_ns) / 1e9

    def _warn_if_stale(self):
        if self._last_msg_ns == 0 and self._count == 0:
            print('  ⚠ 尚未收到检测数据 — 请确认:')
            print('    1. 相机是否在发布图像?   ros2 topic hz /image_raw')
            print('    2. Tag 是否在相机视野内?')
            print(f'    3. 相机坐标系是否为 "{self._camera_frame}"?')
            print('       (用 --camera-frame 指定实际帧名)')
            print()
        elif self._last_msg_ns != 0 and self._count == 0:
            # /detections 在发但一直没有匹配 ID 的 tag — 之前这种情况会完全静默
            print('  ⚠ 收到 /detections 但未见目标 Tag — 请确认:')
            print(f'    1. 画面里的 Tag 是否为 {self._tag_frame}?')
            print('    2. Tag 是否太远/太小/反光? 靠近到 1m 内再试')
            print()
        elif self._count > 0 and not self._buf_dist:
            # 检到了 tag 但 TF 全部查询失败 — 同样会完全静默
            print(f'  ⚠ 已检测到 Tag {self._count} 次, 但 TF 查询失败 '
                  f'{self._tf_fails} 次 — 请确认:')
            print('    1. 相机→Tag 的 TF 是否发布? (apriltag publish_tf)')
            print('    2. 帧名是否匹配? (ros2 run tf2_tools view_frames)')
            print()
        elif self._count > 0 and self._buf_dist and self._det_age() > self._stale_sec:
            # 曾检出过、链路正常, 但目标已连续 1s 无检出 — 移开/遮挡 Tag 就是这种
            # 状态; 不提示的话汇总行会一直打丢失前的旧均值, 看起来像读数稳定
            if not self._stale_warned:
                print(f'  ⚠ Tag 已丢失 {self._det_age():.1f}s — apriltag_node 仍在发布, '
                      f'但目标 Tag 不再出现 (移开/遮挡/太远?)')
                print()
                self._stale_warned = True
        elif (self._last_msg_ns != 0 and self._count > 0 and not self._buf_dist
              and (self.get_clock().now().nanoseconds - self._last_msg_ns) / 1e9 > 2.0):
            # 检出过但 /detections 本身停更 >2s — 检测节点崩了或图像流断了
            print('  ⚠ /detections 已停止发布 — 检查 apriltag_node 是否存活、'
                  '图像话题是否还在发布')
            print()

    def _lookup_and_log(self):
        src_frame = self._measure_frame or self._base_frame

        try:
            t = self._tf_buffer.lookup_transform(
                src_frame, self._tag_frame,
                rclpy.time.Time(seconds=0),
                rclpy.duration.Duration(seconds=0.1))
        except (tf2_ros.LookupException, tf2_ros.ConnectivityException,
                tf2_ros.ExtrapolationException):
            self._tf_fails += 1
            return

        # TF 查询 src_frame→tag 的结果已经是 src_frame 坐标系的表示。
        # 取轴方式取决于 src_frame 是光学系还是常规 REP-103 系：
        #   光学坐标系 (camera_*_optical_frame): z=前, x=右, y=下
        #   常规系 (base_link 等 REP-103):      x=前, y=左, z=上
        # 统一成 "距离>0=在前方, 横向>0=在左" 的语义, 与 _describe_lat/yaw 一致。
        is_optical = 'optical_frame' in src_frame
        if is_optical:
            dist = t.transform.translation.z      # z = 相机正前方距离
            lat  = -t.transform.translation.x     # x=右 → 取负变"左为正"
        else:
            dist = t.transform.translation.x
            lat  = t.transform.translation.y

        # 方位角 = 需要转多少弧度才能正对 Tag
        # atan2(lat, dist)，正=Tag在左边，需要左转(CCW)
        yaw = math.atan2(lat, dist) if dist > 0.001 else 0.0

        self._buf_dist.append(dist)
        self._buf_lat.append(lat)
        self._buf_yaw.append(yaw)

        # 只在新数据到达时打印（10 行一次，避免刷屏）
        if self._count <= 3 or self._count % 10 == 0:
            self._print_one(dist, lat, yaw)

        if self._count % self._sample_batch == 0:
            self._print_summary()

    # ── 单次测量 ──────────────────────────────────────────────────

    def _print_one(self, dist, lat, yaw):
        yaw_deg = math.degrees(yaw)
        direction = _describe_yaw(yaw_deg)
        pos = _describe_lat(lat)

        # 正常距离
        if dist > 0.15:
            color = ''
            reset = ''
        else:
            # 红色警告 — 太近了
            color = '\033[91m'
            reset = '\033[0m'

        print(f'  [{self._count:4d}]  '
              f'{color}距离={dist:.3f}m{reset}  |  '
              f'Tag在{pos}  |  '
              f'朝向={direction} ({yaw_deg:+.0f}°)  |  '
              f'{"⚠ 太近!" if dist < 0.15 else "    "}')

    # ── 实时摘要（每 2 秒）────────────────────────────────────────

    def _print_realtime(self):
        if len(self._buf_dist) < 3:
            return
        # deque 是丢失前的旧样本, 均值已冻结 — 继续打数值会让人误以为 Tag 还在
        age = self._det_age()
        if age > self._stale_sec:
            print(f'\033[91m  ⚠ Tag 已丢失 {age:.0f}s — 上方汇总为丢失前缓存, '
                  f'勿作决策依据\033[0m')
            return
        d_mean = statistics.mean(self._buf_dist)
        d_std  = statistics.stdev(self._buf_dist)
        l_mean = statistics.mean(self._buf_lat)
        y_mean = math.degrees(statistics.mean(self._buf_yaw))

        parts = [f'距离={d_mean:.3f}±{d_std:.3f}m']
        parts.append(f'横向={l_mean:+.3f}m')
        parts.append(f'朝向偏差={y_mean:+.1f}°')
        if self._known_distance > 0:
            err = d_mean - self._known_distance
            parts.append(f'(与已知值差 {err:+.3f}m)')
        if self._tf_fails:
            parts.append(f'TF失败×{self._tf_fails}')

        # 浅色输出，区别于单次测量
        print(f'\033[90m  > {"  |  ".join(parts)}\033[0m')

    # ── 累计汇总 ──────────────────────────────────────────────────

    def _print_summary(self):
        n = len(self._buf_dist)
        if n < 5:
            return

        d_mean = statistics.mean(self._buf_dist)
        d_std  = statistics.stdev(self._buf_dist)
        l_mean = statistics.mean(self._buf_lat)
        l_std  = statistics.stdev(self._buf_lat) if n >= 3 else 0.0
        y_mean = math.degrees(statistics.mean(self._buf_yaw))
        y_std  = math.degrees(statistics.stdev(self._buf_yaw)) if n >= 3 else 0.0

        # 质量评估
        if d_std < 0.005:
            quality = '优 ✓'
        elif d_std < 0.015:
            quality = '良'
        else:
            quality = '差 ⚠ (抖动大)'

        print()
        print('  ═══════════════════════════════════════════')
        print(f'  累计 {self._count} 次检测汇总')
        print(f'  ───────────────────────────────────────────')
        print(f'  距离:  {d_mean:.4f} ± {d_std:.4f} m    数据质量: {quality}')
        print(f'  横向:  {l_mean:.4f} ± {l_std:.4f} m    ({_describe_lat(l_mean)})')
        print(f'  朝向:  {y_mean:.2f} ± {y_std:.2f} °     ({_describe_yaw(y_mean)})')
        if self._known_distance > 0:
            err = d_mean - self._known_distance
            pct = err / self._known_distance * 100
            ok = '✓' if abs(pct) < 3 else '⚠ 偏差偏大，检查标定'
            print(f'  ───────────────────────────────────────────')
            print(f'  对比:  已知 {self._known_distance:.3f}m → 偏差 {err:+.4f}m ({pct:+.1f}%) {ok}')
        if self._tf_fails:
            print(f'  TF 查询失败: {self._tf_fails} 次')
        print('  ═══════════════════════════════════════════')
        print()


# ── apriltag_node 子进程管理 ──────────────────────────────────────────

def _launch_apriltag_node(tag_family: str, tag_size: float, tag_id: int,
                          image_topic: str) -> subprocess.Popen:
    """启动 apriltag_node 子进程。"""
    tag_frame = f'tag{tag_family}:{tag_id}'
    cmd = [
        'ros2', 'run', 'apriltag_ros', 'apriltag_node',
        '--ros-args',
        '-p', f'family:={tag_family}',
        '-p', f'size:={tag_size}',
        '-p', f'tag_ids:=[{tag_id}]',
        '-p', f'tag_frames:=[{tag_frame}]',
        '-p', 'publish_tf:=true',
        '-p', 'z_up:=false',
        # decimate=2 (apriltag_ros 默认) 检测前先把图降采样一半: rtsp_camera 桥
        # 输出 ~640 宽, 1m 外 16cm tag 只剩 ~25px, 低于 36h11 可检下限 → 全空
        # (实测 0/123 帧; 同数据 decimate=1 检出 107/107)。640x360 全分辨率
        # 检测 CPU 开销可忽略, 故关闭降采样。
        '-p', 'detector.decimate:=1.0',
        '-r', f'image_rect:={image_topic}',
    ]
    print(f'  启动 apriltag_node (Tag ID={tag_id}, {tag_size}m) ... ', end='', flush=True)
    proc = subprocess.Popen(
        cmd,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        preexec_fn=os.setsid,
    )
    try:
        time.sleep(2.0)
    except KeyboardInterrupt:
        # 启动等待期间被 Ctrl+C: 先把子进程杀了再走, 否则泄漏
        _kill_apriltag_node(proc)
        raise
    if proc.poll() is not None:
        print('失败！请检查 apriltag_ros 是否已安装。')
        sys.exit(1)
    print('完成')
    return proc


def _kill_apriltag_node(proc: subprocess.Popen):
    """关闭 apriltag_node。"""
    if proc is None or proc.poll() is not None:
        return
    print('  正在关闭 apriltag_node ... ', end='', flush=True)
    try:
        os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
        proc.wait(timeout=3)
    except (ProcessLookupError, subprocess.TimeoutExpired):
        try:
            os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
            proc.wait(timeout=2)
        except (ProcessLookupError, subprocess.TimeoutExpired):
            pass
    print('完成')


# ── main ──────────────────────────────────────────────────────────────

def main(args=None):
    argv = sys.argv[1:] if args is None else args
    try:
        ros_idx = argv.index('--ros-args')
        argv = argv[:ros_idx]
    except ValueError:
        pass

    parser = argparse.ArgumentParser(
        description='AprilTag 实时测量（自动启动 apriltag_node，中文可读输出）',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
示例:
  python3 test_apriltag                                    # 默认参数
  python3 test_apriltag --tag-id 5 --size 0.21             # 自定义 Tag
  python3 test_apriltag --known-distance 1.0               # 与已知距离对比
  python3 test_apriltag --camera-frame camera_depth_optical_frame
        """)
    parser.add_argument('--tag-id', type=int, default=0, help='Tag ID (默认 0)')
    parser.add_argument('--tag-family', default='36h11', help='Tag 家族 (默认 36h11)')
    parser.add_argument('--size', type=float, default=0.16, help='Tag 边长，米 (默认 0.16)')
    parser.add_argument('--image-topic', default='/image_raw', help='相机图像话题')
    parser.add_argument('--camera-frame', default='camera_color_optical_frame',
                        help='相机光学坐标系帧名')
    parser.add_argument('--base-frame', default='base_link', help='机器人基座坐标系')
    parser.add_argument('--measure-frame', default='camera_color_optical_frame',
                        help='从此坐标系查 Tag (默认相机光学系, 直测相机→Tag 距离; '
                             '设为 base_link 测底盘→Tag; 空字符串=用 --base-frame)')
    parser.add_argument('--sample-batch', type=int, default=50,
                        help='每 N 帧输出一次汇总 (默认 50)')
    parser.add_argument('--known-distance', type=float, default=0.0,
                        help='已知真实距离 (m)，用于精度对比')
    cli = parser.parse_args(argv)

    # 启动 apriltag_node
    apriltag_proc = _launch_apriltag_node(
        cli.tag_family, cli.size, cli.tag_id, cli.image_topic)

    # 启动测量节点
    rclpy.init(args=sys.argv if args is None else args)
    node = TestApriltag(
        tag_id=cli.tag_id, tag_family=cli.tag_family, tag_size=cli.size,
        camera_frame=cli.camera_frame, base_frame=cli.base_frame,
        measure_frame=cli.measure_frame,
        sample_batch=cli.sample_batch,
        known_distance=cli.known_distance)

    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        # 先杀 apriltag_node, 再收拾 rclpy:
        # Ctrl+C 时 rclpy 的信号处理器已把 context 关掉了, spin 抛的是
        # ExternalShutdownException, 且 rclpy.shutdown() 会因重复关闭
        # 抛 RCLError —— 如果先调 shutdown, 异常会跳过子进程清理, 造成泄漏
        _kill_apriltag_node(apriltag_proc)
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()
        print('  已退出。')


if __name__ == '__main__':
    main()
